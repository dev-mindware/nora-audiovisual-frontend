# Frontend Environment Configuration
NODE_ENV=development

# Base URL for API
NEXT_PUBLIC_API_URL=https://mindgest.mindware-vps.cloud/api

# Frontend Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Global API Key
NEXT_PUBLIC_API_KEY=

# Session Secret for cookie encryption
SESSION_SECRET=your-32-character-session-secret-here

# Chatbot API
NEXT_PUBLIC_CHATBOT_API_URL=https://chatbot.mindware-vps.cloud/chat

# AGT / SIGT Contribuinte & NIF Verification Credentials (SETIC-FP)
SIGT_BASE_URL=https://sifp.minfin.gov.ao/sigt/contribuinte/consultarNIF
SIGT_USERNAME=
SIGT_PASSWORD=
SIGT_REQUEST_TIMEOUT_MS=10000
